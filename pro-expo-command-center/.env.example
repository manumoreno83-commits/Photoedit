# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Anthropic (server-side only, set in Supabase Edge Function secrets, NEVER in VITE_)
# ANTHROPIC_API_KEY=sk-ant-...

# Odoo (server-side only — set via `supabase secrets set`, NEVER in VITE_)
# ODOO_URL=https://pro-expo.odoo.com
# ODOO_DB=pro-expo
# ODOO_LOGIN=ops@pro-expo.net
# ODOO_API_KEY=...  (Odoo → My Profile → Account Security → New API Key)

# Optional
VITE_APP_ENV=development
